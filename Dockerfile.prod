# syntax=docker/dockerfile:1
# Imagem de produção (gunicorn + whitenoise). O Dockerfile padrão é o de desenvolvimento.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod

WORKDIR /app

COPY requirements/ /app/requirements/
RUN pip install --upgrade pip \
    && pip install -r requirements/prod.txt

COPY . /app

# Home própria: o Docling baixa os modelos de layout/OCR do Hugging Face para
# ~/.cache na primeira conversão (em produção, montado num volume).
RUN useradd --system --uid 1000 --create-home app \
    && mkdir -p /app/media /app/staticfiles /home/app/.cache \
    && chown -R app:app /app/media /app/staticfiles /home/app/.cache
ENV HOME=/home/app
USER app

EXPOSE 8000

ENTRYPOINT ["python", "docker-entrypoint.py"]
CMD ["sh", "-c", "python manage.py collectstatic --noinput && exec gunicorn config.wsgi:application -c gunicorn.conf.py"]
