# Copie este arquivo para ".env" e ajuste os valores.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-localmente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Módulo de settings usado: config.settings.dev (padrão) ou config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://cesucacode:cesucacode@localhost:5432/cesucacode
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- E-mail (envio da senha inicial das contas criadas pelo CSAdmin) ---
# Em desenvolvimento (config.settings.dev) não precisa configurar nada
# aqui — os e-mails aparecem no console/terminal em vez de serem enviados
# de verdade. Em produção, EMAIL_HOST_USER e EMAIL_HOST_PASSWORD são
# obrigatórios (veja config/settings/prod.py).
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=CesucaCode <naoresponda@cesuca.edu.br>

# --- Provedores de IA ---
# Chat: gemini | openai | claude | ollama | deepseek | abacusai | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Papéis de modelo (opcionais): answer (resposta final), router (classificador de
# intenção), agent (passos do loop agêntico), judge (avaliação). Cada um aceita
# LLM_<PAPEL>_PROVIDER, _MODEL, _MAX_TOKENS e _TEMPERATURE; o que faltar cai em
# LLM_PROVIDER/LLM_MODEL e nos padrões (router 256/0, agent 1024/0.2, answer 1500/0.3,
# judge 512/0). Exemplo: um modelo barato só para o roteador:
# LLM_ROUTER_PROVIDER=openrouter
# LLM_ROUTER_MODEL=google/gemini-2.5-flash-lite
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# Força o método de saída estruturada (json_schema | function_calling | json_mode);
# vazio usa o registro de capacidades por provider (apps/ai_providers/capabilities.py).
# LLM_STRUCTURED_METHOD=
# Gemini: orçamento de thinking em tokens (0 desliga). Vazio = padrão do modelo.
# LLM_THINKING_BUDGET=

# Embedding: gemini | ollama
# Mudar de provider/modelo de embedding depois de já ter documentos processados exige
# reprocessar tudo (python manage.py reprocess_documents): o vetor salvo no banco tem
# tamanho fixo (EMBEDDING_DIMENSIONS) e vetores de modelos diferentes não se comparam.
#
# Opção A (padrão) - Gemini, na nuvem:
#   EMBEDDING_PROVIDER=gemini  EMBEDDING_MODEL=gemini-embedding-001  EMBEDDING_DIMENSIONS=768
# Opção B - EmbeddingGemma local via Ollama (sem GPU, sem chave, sem cota; 768 dims, a
# mesma dimensão do Gemini, então não precisa de migration). Requer `ollama pull embeddinggemma`:
#   EMBEDDING_PROVIDER=ollama  EMBEDDING_MODEL=embeddinggemma  EMBEDDING_DIMENSIONS=768
#   (OLLAMA_BASE_URL abaixo; deixe EMBEDDING_MAX_REQUESTS_PER_MINUTE vazio/0)
# Cada modelo distribui as distâncias de um jeito: recalibre RAG_MAX_DISTANCE ao trocar.
# Referência (golden set, out/2026): gemini-embedding-001 ~0.30; embeddinggemma ~0.60
# (trechos relevantes ficaram entre 0.35 e 0.64 de distância cosseno).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Plano gratuito do Gemini aceita 100 embeddings/min: descomente para a ingestão se
# ajustar sozinha (o Plano de Ensino do seed leva ~8 min). Em produção, deixe 0/ausente.
# EMBEDDING_MAX_REQUESTS_PER_MINUTE=90
# EMBEDDING_BATCH_SIZE=100

# Chaves — preencha só a(s) do(s) provider(s) que for usar
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ABACUSAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Caminho do system prompt do chat: uma pasta com arquivos .md (lidos em ordem
# alfabética) ou um único arquivo Markdown/texto.
# Só precisa mudar se quiser usar um prompt diferente do padrão do projeto.
# SYSTEM_PROMPT_PATH=apps/conversations/prompts/sofia

# Distância de cosseno máxima pra um trecho dos materiais entrar no contexto do
# chat (menor = mais rígido). Padrão 0.30 foi calibrado com o modelo de embedding
# atual; com mais material enviado, vale reavaliar.
# RAG_MAX_DISTANCE=0.30
# Busca híbrida (vetorial + textual, fusão RRF). False = só vetorial (como antes).
# RAG_HYBRID_ENABLED=True
# Gancho de reranking; sem implementação ainda, não muda nada.
# RAG_RERANK_ENABLED=False
# Tamanho máximo dos chunks (tokens aproximados). Mudar exige `manage.py reprocess_documents`.
# RAG_CHUNK_MAX_TOKENS=300
# Retry com backoff exponencial para 429/timeout/conexão ao gerar embeddings.
# EMBEDDING_RETRY_ATTEMPTS=3
# EMBEDDING_RETRY_BASE_SECONDS=5

# Mensagens anteriores enviadas ao modelo a cada turno (janela de contexto; não
# limita quantas mensagens o usuário pode enviar).
# CHAT_MAX_HISTORY_MESSAGES=12
# False = modo estrito: só responde com base nos materiais enviados.
# CHAT_ALLOW_GENERAL_KNOWLEDGE=True
# Pesquisa na web (só em perguntas de grade/disciplinas) pra sugerir um caminho
# de estudo. Falhou ou desligada: o chat segue sem ela.
# CHAT_WEB_SEARCH_ENABLED=True
# CHAT_WEB_SEARCH_MAX_RESULTS=5
# CHAT_WEB_SEARCH_TIMEOUT=8

# Testes (pytest): banco com permissão de CREATEDB e de criar a extensão vector.
# Opcional; se vazio, usa DATABASE_URL.
TEST_DATABASE_URL=

# Limite de mensagens enviadas ao chat por usuário (formato DRF: N/min, N/hour, N/day).
# O contador fica no cache do Django; com vários processos, configure um cache
# compartilhado (Redis/Memcached/banco) para o limite valer no total.
# CHAT_THROTTLE_RATE=20/min
# CHAT_DAILY_THROTTLE_RATE=300/day
# Versão do pipeline gravada nos traces das respostas (v2 = harness agêntico).
# PIPELINE_VERSION=v2

# Loop agêntico (perguntas compostas): flag e orçamento. Ao estourar um teto, o
# agente para e responde com o que já coletou.
# CHAT_AGENT_ENABLED=True
# AGENT_MAX_TURNS=5
# AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_TOTAL_TOKENS=40000
# AGENT_MAX_SECONDS=30
# Roteador de intenção: classificador L0 (regras) + L1 (LLM do papel "router").
# False = só L0; o restante usa a heurística da v0 (regex de grade + pergunta anterior).
# CHAT_ROUTER_ENABLED=True
# Passos extras do pipeline (papel "router"): checagem de suficiência do contexto e
# perguntas de continuação (follow-ups). Desligue ambos para aproximar da v0.
# CHAT_SUFFICIENCY_CHECK_ENABLED=True
# CHAT_FOLLOWUPS_ENABLED=True
