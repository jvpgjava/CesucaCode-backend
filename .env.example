# Copie este arquivo para ".env" e ajuste os valores.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-localmente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Módulo de settings usado: config.settings.dev (padrão) ou config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://cesucacode:cesucacode@localhost:5432/cesucacode
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- E-mail (envio da senha inicial das contas criadas pelo CSAdmin) ---
# Em desenvolvimento (config.settings.dev) não precisa configurar nada
# aqui — os e-mails aparecem no console/terminal em vez de serem enviados
# de verdade. Em produção, EMAIL_HOST_USER e EMAIL_HOST_PASSWORD são
# obrigatórios (veja config/settings/prod.py).
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=CesucaCode <naoresponda@cesuca.edu.br>

# --- Provedores de IA ---
# Chat: gemini | openai | claude | ollama | deepseek | abacusai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Embedding: gemini | ollama
# Mudar de provider de embedding depois de já ter documentos processados exige
# reprocessar tudo (o vetor salvo no banco tem tamanho fixo: EMBEDDING_DIMENSIONS).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Chaves — preencha só a(s) do(s) provider(s) que for usar
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ABACUSAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
